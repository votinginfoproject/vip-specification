<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="unqualified" version="7.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- Note: xs:element entities in this file can optionally contain a
       clearable="true" *or* an optionalInOverlay="true" attribute.
       These attributes are process by vip_mainfeed_transform.xsd and
       vip_overlay_transform.xsd via XSLT to create valid XSD schemas
       for VIP feeds and VIP overlays. -->

  <!-- Enumeration types. -->
  <xs:simpleType name="PollingLocationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="InPersonDayOf" />
      <xs:enumeration value="InPersonEarly" />
      <xs:enumeration value="DropOff" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="BallotMeasureType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ballot-measure" />
      <xs:enumeration value="initiative" />
      <xs:enumeration value="referendum" />
      <xs:enumeration value="other" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CandidatePostElectionStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="advanced-to-runoff" />
      <xs:enumeration value="projected-winner" />
      <xs:enumeration value="winner" />
      <xs:enumeration value="withdrawn" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CandidatePreElectionStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="filed" />
      <xs:enumeration value="qualified" />
      <xs:enumeration value="withdrawn" />
      <xs:enumeration value="write-in" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ChecksumAlgorithm">
    <xs:restriction base="xs:string">
      <xs:enumeration value="sha-512" />
      <xs:enumeration value="sha-256" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DistrictType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="borough" />
      <xs:enumeration value="city" />
      <xs:enumeration value="city-council" />
      <xs:enumeration value="congressional" />
      <xs:enumeration value="county" />
      <xs:enumeration value="county-council" />
      <xs:enumeration value="judicial" />
      <xs:enumeration value="municipality" />
      <xs:enumeration value="national" />
      <xs:enumeration value="school" />
      <xs:enumeration value="special" />
      <xs:enumeration value="state" />
      <xs:enumeration value="state-house" />
      <xs:enumeration value="state-senate" />
      <xs:enumeration value="town" />
      <xs:enumeration value="township" />
      <xs:enumeration value="utility" />
      <xs:enumeration value="village" />
      <xs:enumeration value="ward" />
      <xs:enumeration value="water" />
      <xs:enumeration value="other" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="GeospatialFormat">
    <xs:restriction base="xs:string">
      <xs:enumeration value="shp" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IdentifierType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="fips" />
      <xs:enumeration value="local-level" />
      <xs:enumeration value="national-level" />
      <xs:enumeration value="ocd-id" />
      <xs:enumeration value="state-level" />
      <xs:enumeration value="other" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LocationIdentifierType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="latlong" />
      <xs:enumeration value="pluscode" />
      <xs:enumeration value="geocoder-id" />
      <xs:enumeration value="other" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OebEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="both" />
      <xs:enumeration value="even" />
      <xs:enumeration value="odd" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OfficeTermType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="full-term" />
      <xs:enumeration value="unexpired-term" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="VoteVariation">
    <!-- While this will part of v5.0 of VIP, long-term this will likely get
	 replaced by whatever comes out of the NIST "Voting Methods
	 Mathematical Models" Working Group
    -->
    <xs:restriction base="xs:string">
      <xs:enumeration value="1-of-m" />
      <xs:enumeration value="approval" />
      <xs:enumeration value="borda" />
      <xs:enumeration value="cumulative" />
      <xs:enumeration value="majority" />
      <xs:enumeration value="n-of-m" />
      <xs:enumeration value="plurality" />
      <xs:enumeration value="proportional" />
      <xs:enumeration value="range" />
      <xs:enumeration value="rcv" />
      <xs:enumeration value="super-majority" />
      <xs:enumeration value="other" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="VoterServiceType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="absentee-ballots" />
      <xs:enumeration value="overseas-voting" />
      <xs:enumeration value="polling-places" />
      <xs:enumeration value="voter-registration" />
      <xs:enumeration value="other" />
    </xs:restriction>
  </xs:simpleType>

  <!-- Non-enumeration simple types. -->
  <xs:simpleType name="HtmlColorString">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-f]{6}" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ShortString">
    <xs:restriction base="xs:string">
      <xs:maxLength value="16" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TimeWithoutZone">
    <xs:restriction base="xs:time">
      <xs:pattern value="(([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]|(24:00:00))" />
    </xs:restriction>
  </xs:simpleType>

  <!-- Complex types. -->

  <xs:complexType name="BallotMeasureContest">
    <xs:complexContent>
      <xs:extension base="ContestBase">
        <xs:sequence>
          <xs:element name="ConStatement" type="InternationalizedText" clearable="true" />
          <xs:element name="EffectOfAbstain" type="InternationalizedText" minOccurs="0" clearable="true" />
          <xs:element name="FullText" type="InternationalizedText" minOccurs="0" clearable="true" />
          <xs:element name="InfoUri" type="InternationalizedUri" minOccurs="0" clearable="true" />
          <xs:element name="PassageThreshold" type="InternationalizedText" minOccurs="0" clearable="true" />
          <xs:element name="ProStatement" type="InternationalizedText" minOccurs="0" clearable="true" />
          <xs:element name="SummaryText" type="InternationalizedText" minOccurs="0" clearable="true" />
          <xs:element name="Type" type="BallotMeasureType" minOccurs="0" clearable="true" />
          <xs:element name="OtherType" type="xs:string" minOccurs="0" clearable="true" />
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Generic string for a ballot measure (referendum) selection -->
  <xs:complexType name="BallotMeasureSelection">
    <xs:complexContent>
      <xs:extension base="BallotSelectionBase">
        <xs:sequence>
          <xs:element name="Selection" type="InternationalizedText" />
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="BallotSelectionBase" abstract="true">
    <xs:sequence>
      <xs:element name="SequenceOrder" type="xs:integer" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required" />
  </xs:complexType>

  <xs:complexType name="BallotStyle">
    <xs:sequence>
      <xs:element name="ImageUri" type="InternationalizedUri" minOccurs="0" />
      <xs:element name="OrderedContestIds" type="xs:IDREFS" minOccurs="0" />
      <xs:element name="PartyIds" type="xs:IDREFS" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required" />
  </xs:complexType>

  <xs:complexType name="Candidate">
    <xs:sequence>
      <xs:element name="BallotName" type="InternationalizedText" />
      <xs:element name="ContactInformation" type="ContactInformation" minOccurs="0" />
      <xs:element name="ExternalIdentifier" type="ExternalIdentifier" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="FileDate" type="xs:date" minOccurs="0" />
      <xs:element name="IsIncumbent" type="xs:boolean" minOccurs="0" />
      <xs:element name="IsTopTicket" type="xs:boolean" minOccurs="0" />
      <xs:element name="PartyId" type="xs:IDREF" minOccurs="0" />
      <xs:element name="PersonId" type="xs:IDREF" minOccurs="0" />
      <xs:element name="PostElectionStatus" type="CandidatePostElectionStatus" minOccurs="0" />
      <xs:element name="PreElectionStatus" type="CandidatePreElectionStatus" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required" />
  </xs:complexType>

  <xs:complexType name="CandidateContest">
    <xs:complexContent>
      <xs:extension base="ContestBase">
        <xs:sequence>
          <xs:element name="NumberElected" type="xs:integer" minOccurs="0" clearable="true" />
          <xs:element name="OfficeIds" type="xs:IDREFS" minOccurs="0" clearable="true" />
          <xs:element name="PrimaryPartyIds" type="xs:IDREFS" minOccurs="0" clearable="true" />
          <xs:element name="VotesAllowed" type="xs:integer" minOccurs="0" clearable="true" />
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="CandidateSelection">
    <xs:complexContent>
      <xs:extension base="BallotSelectionBase">
        <xs:sequence>
          <xs:element name="CandidateIds" type="xs:IDREFS" />
          <xs:element name="EndorsementPartyIds" type="xs:IDREFS" minOccurs="0" />
          <xs:element name="IsWriteIn" type="xs:boolean" minOccurs="0" />
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Checksum">
    <xs:sequence>
      <xs:element name="Algorithm" type="ChecksumAlgorithm" minOccurs="1" />
      <xs:element name="Value" type="xs:string" minOccurs="1" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ContactInformation">
    <xs:sequence>
      <xs:element name="MailingAddress" type="SimpleAddressType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="PhysicalAddress" type="SimpleAddressType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="LocationIdentifier" type="LocationIdentifier" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="Directions" type="InternationalizedText" minOccurs="0" />
      <xs:element name="Email" type="InternationalizedText" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="Fax" type="InternationalizedText" minOccurs="0" maxOccurs="unbounded" />
      <!-- Note: The "Hours" element is being deprecated and will be removed
           in future versions of VIP.
      -->
      <xs:element name="Hours" type="InternationalizedText" minOccurs="0" />
      <xs:element name="Schedule" type="ScheduleWithTimezone" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="LatLng" type="LatLng" minOccurs="0" />
      <!-- This can be a person or place name. -->
      <xs:element name="Name" type="InternationalizedText" minOccurs="0" />
      <xs:element name="Phone" type="InternationalizedText" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="Uri" type="InternationalizedUri" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="label" type="xs:string" />
  </xs:complexType>

  <xs:complexType name="ContestBase" abstract="true">
    <xs:sequence>
      <xs:element name="Abbreviation" type="xs:string" minOccurs="0" clearable="true" />
      <xs:element name="BallotSelectionIds" type="xs:IDREFS" minOccurs="0" clearable="true" />
      <xs:element name="BallotSubTitle" type="InternationalizedText" minOccurs="0" clearable="true" />
      <xs:element name="BallotTitle" type="InternationalizedText" minOccurs="0" clearable="true" />
      <xs:element name="ElectoralDistrictId" type="xs:IDREF" optionalInOverlay="true" />
      <xs:element name="ElectorateSpecification" type="InternationalizedText" minOccurs="0" clearable="true" />
      <xs:element name="ExternalIdentifier" type="ExternalIdentifier" minOccurs="0" maxOccurs="unbounded" clearable="true" />
      <xs:element name="HasRotation" type="xs:boolean" minOccurs="0" clearable="true" />
      <xs:element name="Name" type="xs:string" optionalInOverlay="true" />
      <xs:element name="SequenceOrder" type="xs:integer" minOccurs="0" clearable="true" />
      <xs:element name="VoteVariation" type="VoteVariation" minOccurs="0" clearable="true" />
      <xs:element name="OtherVoteVariation" type="xs:string" minOccurs="0" clearable="true" />

      <!-- The text of an Inactive tag should be the reason the element is marked inactive. -->
      <xs:element name="IsInactive" type="xs:string" minOccurs="0" clearable="true" />
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required" />
  </xs:complexType>

  <xs:complexType name="EmergencyNotice">
    <xs:sequence>
      <xs:element name="NoticeText" type="InternationalizedText" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="NoticeUri" type="InternationalizedUri" minOccurs="0" />
      <xs:element name="AppliesTo" type="xs:string" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="VoterService">
    <xs:sequence>
      <!--
          The contact information below can be used to override or
          add specific fields to the base Departmental contact information if
          the service has different information.  For example, if the voter
          service has its own phone number, the ContactInformation object
          below can be an object containing only a Phone element.
      -->
      <xs:element name="ContactInformation" type="ContactInformation" minOccurs="0" />
      <xs:element name="Description" type="InternationalizedText" minOccurs="0" />
      <!--
          This is for use if a certain person handles the particular service,
          for example a contact person for overseas voting.
      -->
      <xs:element name="ElectionOfficialPersonId" type="xs:IDREF" minOccurs="0" />
      <xs:element name="Type" type="VoterServiceType" minOccurs="0" />
      <xs:element name="OtherType" type="xs:string" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="label" type="xs:string" />
  </xs:complexType>

  <!-- ElectionAdministration fields are not marked clearable="true" because the entire
       administration entity gets replaced as a single unit in overlays. -->
  <xs:complexType name="ElectionAdministration">
    <xs:sequence>
      <xs:element name="AbsenteeUri" type="InternationalizedUri" minOccurs="0" />
      <xs:element name="AmIRegisteredUri" type="InternationalizedUri" minOccurs="0" />
      <xs:element name="BallotTrackingUri" type="InternationalizedUri" minOccurs="0" />
      <xs:element name="BallotProvisionalTrackingUri" type="InternationalizedUri" minOccurs="0" />
      <xs:element name="ContactInformation" type="ContactInformation" minOccurs="0" />
      <xs:element name="ElectionsUri" type="InternationalizedUri" minOccurs="0" />
      <xs:element name="RegistrationUri" type="InternationalizedUri" minOccurs="0" />
      <xs:element name="RulesUri" type="InternationalizedUri" minOccurs="0" />
      <!-- A locality may have more than one department with each handling different services. -->
      <xs:element name="VoterService" type="VoterService" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="WhatIsOnMyBallotUri" type="InternationalizedUri" minOccurs="0" />
      <xs:element name="WhereDoIVoteUri" type="InternationalizedUri" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ElectoralDistrict">
    <xs:sequence>
      <xs:element name="ExternalIdentifier" type="ExternalIdentifier" minOccurs="0" maxOccurs="unbounded" clearable="true" />
      <xs:element name="Name" type="InternationalizedText" optionalInOverlay="true" />
      <xs:element name="Number" type="xs:integer" minOccurs="0" clearable="true" />
      <xs:element name="Type" type="DistrictType" optionalInOverlay="true" />
      <xs:element name="OtherType" type="xs:string" minOccurs="0" clearable="true" />
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required" />
  </xs:complexType>

  <xs:complexType name="ExternalFile">
    <xs:sequence>
      <xs:element name="FileUri" type="xs:anyURI" minOccurs="1" />
      <xs:element name="Checksum" type="Checksum" minOccurs="1" />
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required" />
  </xs:complexType>

  <xs:complexType name="FeatureIdentifier">
    <xs:sequence>
      <xs:element name="Index" type="xs:string" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ExternalGeospatialFeature">
    <xs:sequence>
      <xs:element name="ExternalFileId" type="xs:IDREF" minOccurs="1" />
      <xs:element name="FileFormat" type="GeospatialFormat" minOccurs="1" />
      <xs:element name="FeatureIdentifier" type="FeatureIdentifier" minOccurs="1" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ExternalIdentifier">
    <xs:sequence>
      <xs:element name="Type" type="IdentifierType" />
      <xs:element name="OtherType" type="xs:string" minOccurs="0" />
      <xs:element name="Value" type="xs:string" />
    </xs:sequence>
    <xs:attribute name="label" type="xs:string" />
    <xs:attribute name="provider" type="xs:string" />
  </xs:complexType>

  <xs:complexType name="LocationIdentifier">
    <xs:sequence>
      <xs:element name="Type" type="LocationIdentifierType" />
      <xs:element name="OtherType" type="xs:string" minOccurs="0" />
      <xs:element name="Value" type="xs:string" />
    </xs:sequence>
    <xs:attribute name="label" type="xs:string" />
    <xs:attribute name="provider" type="xs:string" />
    <xs:attribute name="relativePriority" type="xs:decimal" />
  </xs:complexType>

  <xs:complexType name="Hours">
    <xs:sequence>
      <xs:element name="StartTime" type="TimeWithoutZone" maxOccurs="1" />
      <xs:element name="EndTime" type="TimeWithoutZone" maxOccurs="1" />
    </xs:sequence>
    <xs:attribute name="label" type="xs:string" />
  </xs:complexType>

  <xs:complexType name="ScheduleWithTimezone">
    <xs:sequence>
      <!-- IANA Time Zone, e.g. "Americal/New_York".  Only canonical time zones of the
	   form Continent/City are supported to make the regex as specific as possible.
	   Single-word aliases like CET or EST are not supported.  For hour offsets, use
	   Etc/GMT-X and Etc/GMT+X. If time zone is not present, the hours are assumed
	   to be local time in the time zone of the enclosing entity. -->
      <xs:element name="TimeZone" minOccurs="0">
	<xs:simpleType>
	  <xs:restriction base="xs:string">
	    <xs:pattern value="(Africa|America|Antarctica|Asia|Atlantic|Australia|Etc|Europe|Indian|Pexico|Pacific|US)(/[A-Za-z0-9+-_]+)+" />
	  </xs:restriction>
	</xs:simpleType>
      </xs:element>
      <xs:element name="StartDate" type="xs:date" minOccurs="0" />
      <xs:element name="EndDate" type="xs:date" minOccurs="0" />
      <xs:element name="Hours" type="Hours" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="IsOpen24Hours" type="xs:boolean" minOccurs="0" maxOccurs="1" />
      <xs:element name="IsOnlyByAppointment" type="xs:boolean" minOccurs="0" maxOccurs="1" />
      <xs:element name="IsOrByAppointment" type="xs:boolean" minOccurs="0" maxOccurs="1" />
      <xs:element name="IsSubjectToChange" type="xs:boolean" minOccurs="0" maxOccurs="1" />
    </xs:sequence>
    <xs:attribute name="label" type="xs:string" />
  </xs:complexType>

  <!--
      InternationalizedText: a type representing a word or block of text
      translated into one or more languages.

For example, an instance of:

<xs:element name="Office" type="InternationalizedText" />

could be:

<Office label="office_mayor">
<Text language="en">Mayor</Text>
<Text language="es">Alcalde</Text>
<Text language="zh">市長</Text>
<Text language="i-default">Mayor</Text>
</Office>

The optional "label" attribute can be used to name the text being
translated.  For example, if the translations come from a comma-delimited
flat file, the label for the corresponding row in the flat file could be
stored in this attribute for tracking purposes.  In the above example, the
element could have come from a flat file with row:

office_mayor,Mayor,Alcalde,市長

The language tag "i-default" is used for the "fallback" text that clients
should use when a desired language version is not available.

Alternatively, the field may omit the Text elements.  In this case the body
of the element is treated as having lanugage "i-default":

<Office label="office_mayor">Mayor</Office>

The above example is equivalent to:

<Office label="office_may">
<Text language="i-default">Mayor</Text>
</Office>

A separate schematron rule will bar combining plain text with <Text> sub-elements
and will enforce that each text language is different.
  -->
  <xs:complexType name="InternationalizedText" mixed="true">
    <xs:sequence>
      <xs:element name="Text" type="LanguageString" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="label" type="xs:string" />
  </xs:complexType>

  <!--
      LanguageString: a type representing a string with a language specified.
  -->
  <xs:complexType name="LanguageString">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="language" type="xs:language" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!--
      InternationalizedUri: a type representing URIs for the same materials in
      different languages.  It works like InternationlizedText.
  -->
  <xs:complexType name="InternationalizedUri" mixed="true">
    <xs:sequence>
      <xs:element name="Uri" type="LanguageUri" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="label" type="xs:string" />
  </xs:complexType>

  <!--
      LanguageURI: a type representing an annotated URI with a language specified.
  -->
  <xs:complexType name="LanguageUri">
    <xs:simpleContent>
      <xs:extension base="xs:anyURI">
        <xs:attribute name="language" type="xs:language" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="LatLng">
    <xs:sequence>
      <xs:element name="Latitude" type="xs:double" maxOccurs="1" />
      <xs:element name="Longitude" type="xs:double" maxOccurs="1" />
      <xs:element name="Source" type="xs:string" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="label" type="xs:string" />
  </xs:complexType>

  <xs:complexType name="Locality">
    <xs:sequence>
      <xs:element name="ElectionAdministration" type="ElectionAdministration" minOccurs="0" clearable="true" />
      <xs:element name="EmergencyNotice" type="EmergencyNotice" minOccurs="0" onlyInOverlay="true" />
      <xs:element name="ExternalIdentifier" type="ExternalIdentifier" minOccurs="0" maxOccurs="unbounded" clearable="true" />
      <xs:element name="IsMailOnly" type="xs:boolean" minOccurs="0" maxOccurs="1" clearable="true" />
      <xs:element name="Name" type="xs:string" optionalInOverlay="true" />
      <xs:element name="PollingLocationIds" type="xs:IDREFS" minOccurs="0" clearable="true" />
      <xs:element name="ParentLocalityId" type="xs:IDREF" minOccurs="0" clearable="true" />
      <xs:element name="Type" type="DistrictType" minOccurs="0" clearable="true" />
      <xs:element name="OtherType" type="xs:string" minOccurs="0" clearable="true" />

      <!-- Default hours are specified separately for each polling location type. -->
      <xs:element name="DefaultPollingHours" type="ScheduleWithTimezone" minOccurs="0" maxOccurs="unbounded" clearable="true" />
      <xs:element name="OverriddenPollingHours" type="ScheduleWithTimezone" minOccurs="0" maxOccurs="unbounded" onlyInOverlay="true" />
      <xs:element name="DefaultEarlyVoteHours" type="ScheduleWithTimezone" minOccurs="0" maxOccurs="unbounded" clearable="true" />
